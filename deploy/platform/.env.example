# Compose project and immutable service images published by GitHub Actions
COMPOSE_PROJECT_NAME=go-platform
PLATFORM_DOCKER_PLATFORM=linux/amd64
PLATFORM_MANAGER_IMAGE=registry.cn-qingdao.aliyuncs.com/limes-cloud/manager:v1.2.10
PLATFORM_CONFIGURE_IMAGE=registry.cn-qingdao.aliyuncs.com/limes-cloud/configure:v1.0.51
PLATFORM_RESOURCE_IMAGE=registry.cn-qingdao.aliyuncs.com/limes-cloud/resource:v1.2.4
PLATFORM_GATEWAY_IMAGE=registry.cn-qingdao.aliyuncs.com/limes-cloud/gateway:v1.2.1

# Runtime
PLATFORM_ENV=PROD
PLATFORM_DB_HOST=127.0.0.1
PLATFORM_DB_PORT=3306
# Keep false after init-db.sh has created the databases and users.
PLATFORM_DB_AUTO_CREATE=false
PLATFORM_REDIS_ADDR=127.0.0.1:6379
PLATFORM_REDIS_PASSWORD=

# MySQL administrator, used only by init-db.sh. Never passed to containers.
PLATFORM_MYSQL_ADMIN_USER=root
PLATFORM_MYSQL_ADMIN_PASSWORD=
# Optional: /www/server/mysql/bin/mysql
PLATFORM_MYSQL_BIN=mysql

# Per-service DB credentials. Passwords should use A-Z a-z 0-9 . _ - only.
PLATFORM_MANAGER_DB_NAME=ns_manager_v2
PLATFORM_MANAGER_DB_USER=manager
PLATFORM_MANAGER_DB_PASSWORD=
PLATFORM_CONFIGURE_DB_NAME=configure
PLATFORM_CONFIGURE_DB_USER=configure
PLATFORM_CONFIGURE_DB_PASSWORD=
PLATFORM_RESOURCE_DB_NAME=resource
PLATFORM_RESOURCE_DB_USER=resource
PLATFORM_RESOURCE_DB_PASSWORD=
PLATFORM_GATEWAY_DB_NAME=gateway
PLATFORM_GATEWAY_DB_USER=gateway
PLATFORM_GATEWAY_DB_PASSWORD=

# manager app JWT secret, used only when seeding a fresh manager DB.
# Generate with: openssl rand -hex 32
PLATFORM_MANAGER_JWT_SECRET=

# Bind addresses. Keep loopback-only and put Nginx in front.
PLATFORM_MANAGER_HTTP_HOST=127.0.0.1
PLATFORM_CONFIGURE_HTTP_HOST=127.0.0.1
PLATFORM_RESOURCE_HTTP_HOST=127.0.0.1
PLATFORM_GATEWAY_ADDR=127.0.0.1:7200
PLATFORM_MANAGER_GRPC=127.0.0.1:8202

# Production hardening
PLATFORM_MANAGER_PPROF_ENABLE=false
PLATFORM_MANAGER_PPROF_SECRET=
# Gateway management API token verification. Keep this pointed at manager.
PLATFORM_GATEWAY_ADMIN_AUTH_URL=http://127.0.0.1:7202/manager/api/v1/authorize/token/parse
