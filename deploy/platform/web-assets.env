# Web 静态资源托管配置（由 build-web.sh / publish-web-assets.sh 读取）
#
# 背景：psou 机器（137.175.100.69）到国内的访问速度很慢，admin-web / psou-web
# 的构建产物统一放到 rustfs 机器（47.108.186.217）的 nginx 上直出。
# 两个站点的 assets 合并到同一个目录，文件名带 content hash；
# 发布脚本会保存每个站点的 sha256 清单并在合并后交叉校验，防止同名文件互相覆盖。
#
# 47 上对应的 nginx 片段见 deploy/platform/nginx/47-assets.conf。

# 静态资源对外基址。结尾不需要斜杠；构建产物会引用 ${WEB_ASSET_ORIGIN}/assets/...
WEB_ASSET_ORIGIN=https://47.108.186.217

# 47 的 rs 节点名（rs node list 中的名字）
WEB_ASSET_NODE=rustfs

# 部署 Web 入口（index.html / 服务重启）的 rs 节点名
WEB_ASSET_WEB_NODE=psou

# 47 上 assets 的落盘目录，必须与 nginx location 的 root + /assets 对应
WEB_ASSET_REMOTE_ROOT=/www/wwwroot/47.108.186.217/assets

# 各站点 sha256 清单目录，放在 web 根目录之外，避免被 nginx 暴露
WEB_ASSET_REMOTE_MANIFEST_DIR=/www/wwwroot/47.108.186.217/.asset-manifests

# Web 入口所在目录与服务名（发布脚本会改 index.html 并重启服务）
ADMIN_WEB_REMOTE_DIR=/www/software/go-platform/admin-web/current/web
ADMIN_WEB_SERVICE=go-platform-admin-web.service
ADMIN_WEB_PUBLIC_URL=https://admin.psou.us

PSOU_WEB_REMOTE_DIR=/www/software/go-platform/psou-web/current/web
PSOU_WEB_SERVICE=go-platform-psou-web.service
PSOU_WEB_PUBLIC_URL=https://psou.us
